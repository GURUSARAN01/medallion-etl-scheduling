# =========================================================
# Python
# =========================================================
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging, tests, and tooling
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# =========================================================
# Airflow runtime files
# =========================================================
airflow/.env
airflow/logs/
airflow/*.pid
airflow/airflow.db
airflow/airflow-webserver.pid
airflow/webserver_config.py

# =========================================================
# Docker and local databases
# =========================================================
postgres_data/
airflow/postgres_data/
*.db
*.sqlite
*.sqlite3

# =========================================================
# Raw and large benchmark data
# =========================================================
data/tpcds/
*.parquet
*.orc
*.avro
*.delta
*.jsonl
*.tsv

# CSV files are ignored by default, then thesis result tables
# are explicitly included for reproducibility.
*.csv
!analysis/outputs/*.csv
!analysis/azure/bronze/*.csv
!analysis/azure/silver/*.csv
!analysis/azure/gold/*.csv
!analysis/azure/official_n5/*.csv
!analysis/azure/mechanisms/**/*.csv
!analysis/azure/combined/*.csv
!ml/features/*.csv
!ml/training/outputs/*.csv

# =========================================================
# Databricks / Delta local artifacts
# =========================================================
databricks/delta/
.delta/
_delta_log/

# =========================================================
# ML and experiment artifacts
# =========================================================
ml/mlflow/
mlruns/
*.pkl
*.pickle
*.joblib
!ml/training/outputs/xgboost_priority_model.joblib
*.model
*.bin
*.onnx

# =========================================================
# Secrets and credentials
# =========================================================
.env
*.env
.env.*
secrets/
*.pem
*.key
*.crt
*.pfx
*.json.secret
credentials.json
token.json

# =========================================================
# IDE and operating-system files
# =========================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# =========================================================
# Jupyter checkpoints
# =========================================================
.ipynb_checkpoints/

# =========================================================
# LaTeX build files
# Keep .tex and .bib files tracked.
# =========================================================
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv
*.nav
*.snm
*.vrb

# =========================================================
# Temporary and backup files
# =========================================================
*.tmp
*.temp
*.bak
*.bak_*
*.swp
~$*
*.zip
